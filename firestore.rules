rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any authenticated user can read (needed for pairing code search).
    // Only owner can write/update their profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Notifications: inbox owner can read, update (mark read), or delete.
    // Any signed-in user can create/send a notification (pair request, SOS alert, etc.).
    match /notifications/{uid}/items/{notifId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null;
    }

    // Pair requests: participants can read and write.
    match /pairRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Pairs: active pairs between ward and guardian.
    match /pairs/{pairId} {
      allow read, write: if request.auth != null;
    }

    // Emergencies: live SOS sessions and location points.
    // Must be readable by authenticated guardians querying whereIn('wardUid', ...)
    // and writable by ward broadcasting SOS or resolving.
    match /emergencies/{emergencyId} {
      allow read, write: if request.auth != null;
      
      // Subcollections (e.g. location history points if used)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
