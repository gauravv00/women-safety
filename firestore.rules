rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any signed-in user can read (needed for pairingCode lookup).
    // Only owner can write.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Notifications: owner can read/update/delete.
    // Any signed-in user can create IF fromUid == their uid.
    match /notifications/{uid}/items/{notifId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;
    }

    // Pair requests: participants can read; guardian writes on creation.
    match /pairRequests/{requestId} {
      allow read: if request.auth != null
                  && (resource.data.guardianUid == request.auth.uid
                      || resource.data.wardUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.guardianUid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.guardianUid == request.auth.uid
                        || resource.data.wardUid == request.auth.uid);
    }

    // Pairs: readable by both members; deletable by either member.
    match /pairs/{pairId} {
      allow read: if request.auth != null
                  && (resource.data.wardUid == request.auth.uid
                      || resource.data.guardianUid == request.auth.uid);
      allow create: if request.auth != null;
      allow delete: if request.auth != null
                    && (resource.data.wardUid == request.auth.uid
                        || resource.data.guardianUid == request.auth.uid);
    }

    // Emergencies: ward writes; guardians with a pairs doc linking them can read.
    match /emergencies/{emergencyId} {
      allow write: if request.auth != null
                   && request.resource.data.wardUid == request.auth.uid;
      allow read: if request.auth != null
                  && (resource.data.wardUid == request.auth.uid
                      || exists(/databases/$(database)/documents/pairs/$(resource.data.wardUid + '_' + request.auth.uid)));
    }
  }
}
